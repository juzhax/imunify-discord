# Parsed as data, never sourced as shell. No quotes or inline comments.
# Five numeric cron fields; time is the server's local timezone.
SCAN_CRON=0 3 * * *
# One or more space-separated existing directories, for example:
# SCAN_PATH=/home /var/lib/docker/volumes
SCAN_PATH=/home
# Managed scans explicitly do not follow symlinks.
# 1 (lowest load) through 7 (highest). Only these on-demand scans are affected.
SCAN_CPU=2
SCAN_IO=2
